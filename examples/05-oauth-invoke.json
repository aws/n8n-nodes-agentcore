{
  "name": "AgentCore — OAuth Bearer Invoke",
  "meta": {
    "_note": "Invokes an OAuth-protected harness (one with an inbound JWT authorizer) using a Bearer token. The JWT is NOT set on this node — it is stored on the Amazon Bedrock AgentCore API credential, in its optional 'OAuth Bearer Token' field. Set Authentication to 'OAuth Bearer Token' on the node, then paste a valid, unexpired JWT from your identity provider into that credential field before running. The node's AWS keys on the same credential are still used for the control-plane GetHarness summary. Because the token lives in the credential vault, it cannot be wired in per-execution from an upstream node; rotate it in the credential when it expires."
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agentcore-oauth",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "harnessArn": "arn:aws:bedrock-agentcore:us-west-2:123456789012:harness/OAuthHarness-abc1234567",
        "prompt": "={{ $('Webhook').item.json.body.message }}",
        "authentication": "oauthBearer",
        "sessionId": "={{ $('Webhook').item.json.body.sessionId }}"
      },
      "id": "2",
      "name": "Invoke with Bearer",
      "type": "@aws/n8n-nodes-agentcore.agentCoreHarness",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "agentCoreApi": {
          "id": "1",
          "name": "AgentCore creds (with OAuth Bearer Token)"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "3",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Invoke with Bearer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Invoke with Bearer": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
